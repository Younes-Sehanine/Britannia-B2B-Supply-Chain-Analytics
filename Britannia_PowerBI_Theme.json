        ]
      }
    },
    "card": {
      "*": {
        "background": [
          { "show": true, "color": { "solid": { "color": "#1A2E4A" } } }
        ],
        "labels": [
          { "color": { "solid": { "color": "#F5A623" } }, "fontSize": 28, "fontFamily": "Segoe UI" }
        ],
        "categoryLabels": [
          { "color": { "solid": { "color": "#FFFFFF" } }, "fontSize": 10, "fontFamily": "Segoe UI" }
        ],
        "callout": [
          { "color": { "solid": { "color": "#F5A623" } }, "fontSize": 28, "fontFamily": "Segoe UI" }
        ],
        "categoryLabel": [
          { "color": { "solid": { "color": "#FFFFFF" } }, "fontSize": 10, "fontFamily": "Segoe UI" }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "background": [
          { "show": true, "color": { "solid": { "color": "#1A2E4A" } } }
        ],
        "dataLabels": [
          { "color": { "solid": { "color": "#F5A623" } }, "fontSize": 20 }
        ],
        "categoryLabels": [
          { "color": { "solid": { "color": "#FFFFFF" } }, "fontSize": 10 }
        ]
      }
    },
    "kpi": {
      "*": {
        "background": [
          { "show": true, "color": { "solid": { "color": "#1A2E4A" } } }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#1A2E4A" } },
            "bold": true
          }
        ],
        "values": [
          { "fontColor": { "solid": { "color": "#8C6A46" } } }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#1A2E4A" } },
            "bold": true
          }
        ],
        "values": [
          { "fontColor": { "solid": { "color": "#8C6A46" } } }
        ]
